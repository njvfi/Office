@{
    ViewData["Title"] = "Login";
}
@model Офіс.Models.LoginModel

<div class="text-center">
    <h2 class="display-4">Login</h2>
</div>

<form asp-action="Login" asp-controller="Users" asp-anti-forgery="true">
    <div class="validation" asp-validation-summary="ModelOnly"></div>
    <div>
        <div class="form-group">
            <label asp-for="Username">Введіть email або username</label>
            <input type="text" asp-for="Username" />
            <span asp-validation-for="Username" />
        </div>
        <div class="form-group">
            <label asp-for="Password">Введіть пароль</label>
            <input type="password" asp-for="Password" />
            <span asp-validation-for="Password" />
        </div>
        <div class="form-group">
            <input type="submit" value="Увійти" class="btn btn-outline-dark" />
        </div>
    </div>
</form>
<form asp-controller="Users" asp-action="Register">
    <input type="submit" value="Реєстрація" />
</form>