@{
    ViewData["Title"] = "Register";
}
@model Офіс.DAL.Entities.RegisterModel

<form asp-action="Register" asp-anti-forgery="true">
    <div class="validation" asp-validation-summary="ModelOnly"></div>
    <div>
        <div class="form-group">
            <label asp-for="Username">Введіть юзернейм</label>
            <input asp-for="Username"/>
            <span asp-validation-for="Username"/>
        </div>
        <div class="form-group">
            <label asp-for="Email">Введіть Email</label>
            <input asp-for="Email"/>
            <span asp-validation-for="Email"/>
        </div>
        <div class="form-group">
            <label asp-for="Password">Введіть пароль</label>
            <input type="password" asp-for="Password"/>
            <span asp-validation-for="Password"/>
        </div>
        <div class="form-group">
            <label asp-for="Repeat">Повторіть пароль</label>
            <input type="password" asp-for="Repeat"/>
            <span asp-validation-for="Repeat"/>
        </div>
        <div class="form-group">
            <input type="submit" value="Реєстрація" class="btn btn-outline-dark" />
        </div>
    </div>
</form>