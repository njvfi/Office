@{
	ViewData["Title"] = "About us";
}
<h1 class="display-2">About Us</h1>

@if (User.Identity.IsAuthenticated)
{
	<h1>Welcome user</h1>
	if (User.IsInRole("Member"))
	{
		<h1>Welcome, office member</h1>
	}
}
